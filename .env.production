# =========================================================
# COLORA WebAR - Production Configuration
# =========================================================

# Product
VITE_PRODUCT_SKU=RING-DEMO-001
VITE_PRODUCT_NAME=Classic Ring
VITE_ASSET_VERSION=2

# Physical product metadata
VITE_RING_OUTER_DIAMETER_MM=18

# ---------------------------------------------------------
# 3D models
# ---------------------------------------------------------

# Optimized legacy-model LODs generated from public/models/nhan.glb.
# The original nhan.glb remains available as a rollback source.
VITE_RING_MODEL_HIGH=models/nhan-high.glb
VITE_RING_MODEL_MEDIUM=models/nhan-medium.glb
VITE_RING_MODEL_LOW=models/nhan-low.glb

# iOS Apple Quick Look
VITE_RING_USDZ=models/nhan.usdz
VITE_RING_PREVIEW=models/nhan-preview.png

# ---------------------------------------------------------
# Depth / Occlusion
# ---------------------------------------------------------

# Keep OFF until model + physical device QA passes.
VITE_ENABLE_MONOCULAR_DEPTH=false
VITE_DEPTH_MODEL=models/depth/depth_anything_v2_small.onnx

# ---------------------------------------------------------
# Metric sizing
# ---------------------------------------------------------

# Do not claim true-size measurement until calibrated.
VITE_ENABLE_METRIC_SIZING=false
VITE_METRIC_CALIBRATION_VALIDATED=false

# ---------------------------------------------------------
# Privacy / Analytics
# ---------------------------------------------------------

VITE_ENABLE_PRIVACY_TELEMETRY=false
VITE_TELEMETRY_ENDPOINT=/telemetry/ar
