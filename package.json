{
  "name": "wear-jewelry-ar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:mediapipe && vite",
    "compress-3d": "node scripts/compress-model.js",
    "typecheck": "tsc --noEmit",
    "build": "npm run sync:mediapipe && npm run validate:assets && npm run typecheck && vite build && npm run generate:integrity && npm run verify:integrity",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:e2e": "playwright test",
    "test:e2e:stability": "playwright test --grep @stability",
    "check:bundle": "node scripts/check-bundle-size.js",
    "verify:integrity": "node scripts/verify-integrity-manifest.mjs",
    "lint:csp": "node scripts/lint-csp.mjs",
    "quality": "npm run sync:mediapipe && npm run validate:dependencies && npm run validate:assets && npm run typecheck && npm run lint && npm test && npm run test:integration && npm run lint:csp && npm run audit:privacy && npm run build && npm run check:bundle",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "lod": "node scripts/generate-lod.js",
    "compress-model": "node scripts/compress-model.js",
    "build:assets": "npm run validate:source-model && npm run lod && npm run compress-model && npm run validate:ring-semantics && npm run validate:production-models",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:ring-semantics": "node scripts/semanticize-ring-glb.mjs public/models/nhan-high.glb",
    "validate:dependencies": "node scripts/validate-dependencies.mjs",
    "generate:integrity": "node scripts/generate-integrity-manifest.mjs",
    "verify:headers": "node scripts/verify-deployment-headers.mjs",
    "audit:privacy": "node scripts/audit-privacy-boundary.mjs",
    "sync:mediapipe": "node scripts/sync-mediapipe-wasm.mjs",
    "validate:production-models": "node scripts/audit-ring-assets.mjs",
    "quality:release": "npm run quality && npm run validate:ring-semantics && npm run validate:production-models",
    "validate:source-model": "node scripts/semanticize-ring-glb.mjs assets/models/raw/nhan.glb"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.2",
    "onnxruntime-web": "^1.20.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.170.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^3.10.1",
    "@gltf-transform/extensions": "^3.10.1",
    "@gltf-transform/functions": "^3.10.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "draco3dgltf": "^1.5.7",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "meshoptimizer": "~1.1.1"
  },
  "overrides": {
    "three": "^0.170.0"
  },
  "resolutions": {
    "three": "^0.170.0"
  }
}
