{
  "name": "wear-jewelry-ar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "compress-3d": "node scripts/compress-model.js",
    "build": "npm run compress-3d && npm run sign:assets && tsc && vite build && npm run generate:sri",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "lod": "node scripts/generate-lod.js",
    "compress-model": "node scripts/compress-model.js",
    "build:assets": "npm run lod && npm run compress-model",
    "generate:sri": "node scripts/generate-sri.js",
    "sign:assets": "node scripts/sign-assets.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.2",
    "@svenflow/micro-handpose": "^0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": ">=0.170.0",
    "zustand": "^4.5.2",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "onnxruntime-web": "^1.20.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^3.10.1",
    "@gltf-transform/extensions": "^3.10.1",
    "@gltf-transform/functions": "^3.10.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "draco3dgltf": "^1.5.7",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
